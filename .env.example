# King Auto Lamp — Environment Variables
# Copy this file to .env.local and fill in your values.

# =============================================
# STORE CONFIGURATION
# =============================================
NEXT_PUBLIC_STORE_NAME="King Auto Lamp"
NEXT_PUBLIC_STORE_TAGLINE="Premium Automotive Lighting"
NEXT_PUBLIC_STORE_DESCRIPTION="Spesialis lampu otomotif premium - LED Projector, LED Headlight, Fog Lamp & Accessories."

# =============================================
# WHATSAPP CONFIGURATION
# =============================================
# Format: 62xxxxxxxx (kode negara Indonesia, tanpa angka 0 di depan)
NEXT_PUBLIC_WHATSAPP_NUMBER="6282298995682"
NEXT_PUBLIC_WHATSAPP_GREETING="Halo Admin Lumora AutoLights"

# =============================================
# CONTACT INFORMATION
# =============================================
NEXT_PUBLIC_INSTAGRAM="@kingautolamp"
NEXT_PUBLIC_INSTAGRAM_URL="https://www.instagram.com/kingautolamp"
NEXT_PUBLIC_STORE_ADDRESS="Makassar"
NEXT_PUBLIC_STORE_HOURS_WEEKDAY="Senin - Jumat: 08.00 - 17.00 WIB"
NEXT_PUBLIC_STORE_HOURS_WEEKEND="Sabtu: 08.00 - 15.00 WIB"
NEXT_PUBLIC_STORE_HOURS_SUNDAY="Minggu: Tutup"

# =============================================
# GOOGLE MAPS (Optional)
# =============================================
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=""

# =============================================
# SUPABASE (Optional - for production database)
# =============================================
# NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# =============================================
# ADMIN CREDENTIALS (Change these!)
# =============================================
# Used for local/demo admin login (replace with Supabase Auth in production)
NEXT_PUBLIC_ADMIN_USERNAME="admin"
ADMIN_PASSWORD_HASH="lumora2024admin"
